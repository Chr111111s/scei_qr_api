# ============================================================
# scei_qr_api (FastAPI) - Variables de entorno
# Copia este archivo a .env y ajusta los valores.
# ============================================================

# PostgreSQL local (docker compose usa el host "db").
# Para el host fuera de Docker usa localhost. Para Neon usa la URL pooled
# y recuerda el driver asyncpg.
DATABASE_URL="postgresql+asyncpg://scei:scei_dev@localhost:5432/scei_qr"

# URL para migraciones Alembic. Si se omite se usa DATABASE_URL.
# En Neon conviene apuntar a la URL directa (sin -pooler).
DIRECT_URL="postgresql+asyncpg://scei:scei_dev@localhost:5432/scei_qr"

# --- Auth ---
# Genera uno propio: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="cambia-este-secreto-por-uno-de-32-bytes-o-mas"
JWT_EXPIRATION="8h"

# --- Servidor ---
PORT=3000
CORS_ORIGIN="*"

# --- Fotos de incidencias ---
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"

# --- Push notifications (opcional) ---
# JSON de la service account de Firebase codificado en base64.
FIREBASE_SERVICE_ACCOUNT=""

# --- Datos demo al arrancar el contenedor ---
SEED_ON_START=false
